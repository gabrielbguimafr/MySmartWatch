# =====================================================================
# Regra do projeto: NENHUM dado pessoal vai para o git.
# O repositório guarda só código, esquemas e testes. Dados de saúde,
# chaves, perfil, logs e documentos gerados ficam apenas no PC.
# =====================================================================

# --- Segredos e perfil (auth key, MAC, peso, altura, nascimento) ---
.env
.env.*
.streamlit/secrets.toml
.claude/settings.local.json

# --- Dados do relógio e do app ---
# brutos do relógio, logs do Mi Fitness, banco SQLite, referências baixadas
.dados/
# qualquer arquivo de dados, onde quer que apareça
*.db
*.db-journal
*.sqlite
*.sqlite3
*.bin
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.pkl
*.pickle
*.npy
*.npz
*.log
*.log.*
*.zip
*.apkg

# --- Documentos e exports gerados (contêm números pessoais) ---
docs/
exports/
*.pdf
*.docx

# --- Orquestrador ---
# respostas dos modelos e cópias de código usadas como contexto
.orquestrador/resultados/
.orquestrador/ctx/

# --- Python / ferramentas ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
